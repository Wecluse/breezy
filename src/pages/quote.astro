---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Request a fictional aircon service quote from Breezy." />
    <title>Request a quote | Breezy</title>
  </head>
  <body class="bg-[#f7fbff] font-sans text-slate-900 antialiased">
    <a class="absolute left-4 top-4 z-50 -translate-y-16 rounded-lg bg-slate-950 px-4 py-3 text-sm font-bold text-white transition focus:translate-y-0" href="#main-content">Skip to content</a>

    <header class="relative z-20 border-b border-sky-100 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
        <a href="/" class="flex items-center gap-2.5 text-2xl font-black tracking-tight text-sky-950" aria-label="Breezy home">
          <span class="grid size-9 place-items-center rounded-xl bg-sky-600 text-white shadow-sm" aria-hidden="true"><svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="2.4"><path d="M4 9h11a3 3 0 1 0-3-3" stroke-linecap="round"/><path d="M4 15h15a3 3 0 1 1-3 3" stroke-linecap="round"/></svg></span>
          Breezy
        </a>
        <nav class="hidden items-center gap-7 text-sm font-semibold text-slate-600 md:flex" aria-label="Primary navigation">
          <a class="transition hover:text-sky-700" href="/services/">Services</a>
          <a class="transition hover:text-sky-700" href="/#how-it-works">How it works</a>
          <a class="transition hover:text-sky-700" href="/#faq">FAQs</a>
        </nav>
        <a href="/quote/" class="hidden rounded-md bg-sky-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-sky-700 focus:outline-2 focus:outline-offset-2 focus:outline-sky-600 md:inline-flex" aria-current="page">Request a quote</a>
        <details class="relative md:hidden">
          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-sky-200 px-3 py-2 text-sm font-bold text-sky-800 transition hover:bg-sky-50 [&::-webkit-details-marker]:hidden">Menu <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="2.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
          <nav class="absolute right-0 top-full z-30 mt-3 w-56 rounded-xl border border-sky-100 bg-white p-2 shadow-xl" aria-label="Mobile navigation">
            <a class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-sky-50 hover:text-sky-700" href="/services/">Services</a>
            <a class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-sky-50 hover:text-sky-700" href="/#how-it-works">How it works</a>
            <a class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-sky-50 hover:text-sky-700" href="/#faq">FAQs</a>
            <a class="mt-1 block rounded-lg bg-sky-600 px-3 py-2.5 text-sm font-bold text-white transition hover:bg-sky-700" href="/quote/" aria-current="page">Request a quote</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:py-24">
        <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-start lg:gap-20">
          <div class="lg:sticky lg:top-8">
            <p class="text-sm font-black uppercase tracking-[0.18em] text-sky-600">Request a quote</p>
            <h1 class="mt-4 text-4xl font-black tracking-[-0.045em] text-sky-950 sm:text-5xl">Tell us what needs a little breeze.</h1>
            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">Share a few details about your aircon unit and the help you need. We’ll use this information to prepare a clear starting estimate.</p>
            <div class="mt-9 rounded-2xl bg-sky-950 p-6 text-sky-100">
              <p class="text-sm font-black uppercase tracking-[0.16em] text-teal-300">What happens next</p>
              <ol class="mt-5 space-y-4 text-sm leading-6 text-sky-100/85">
                <li class="flex gap-3"><span class="grid size-6 shrink-0 place-items-center rounded-full bg-sky-800 font-black text-teal-300">1</span><span>We review the details of your request.</span></li>
                <li class="flex gap-3"><span class="grid size-6 shrink-0 place-items-center rounded-full bg-sky-800 font-black text-teal-300">2</span><span>We recommend the right service and a clear next step.</span></li>
                <li class="flex gap-3"><span class="grid size-6 shrink-0 place-items-center rounded-full bg-sky-800 font-black text-teal-300">3</span><span>You decide when you would like to book.</span></li>
              </ol>
            </div>
          </div>

          <div class="rounded-3xl border border-sky-100 bg-white p-6 shadow-sm sm:p-9">
            <form id="quote-form" novalidate>
              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="name" class="text-sm font-bold text-sky-950">Full name</label>
                  <input id="name" name="name" autocomplete="name" required class="mt-2 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-sky-600 focus:ring-2 focus:ring-sky-100" placeholder="Juan dela Cruz" />
                </div>
                <div>
                  <label for="phone" class="text-sm font-bold text-sky-950">Mobile number</label>
                  <input id="phone" name="phone" type="tel" autocomplete="tel" required class="mt-2 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-sky-600 focus:ring-2 focus:ring-sky-100" placeholder="0917 123 4567" />
                </div>
              </div>
              <div class="mt-6">
                <label for="email" class="text-sm font-bold text-sky-950">Email address</label>
                <input id="email" name="email" type="email" autocomplete="email" required class="mt-2 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-sky-600 focus:ring-2 focus:ring-sky-100" placeholder="you@example.com" />
              </div>
              <div class="mt-6 grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="service" class="text-sm font-bold text-sky-950">Service needed</label>
                  <select id="service" name="service" required class="mt-2 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-100">
                    <option value="" disabled selected>Select a service</option>
                    <option>Aircon cleaning</option>
                    <option>Repair &amp; diagnostics</option>
                    <option>Installation</option>
                    <option>Preventive maintenance</option>
                    <option>Not sure yet</option>
                  </select>
                </div>
                <div>
                  <label for="location" class="text-sm font-bold text-sky-950">Area or city</label>
                  <input id="location" name="location" required class="mt-2 w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-sky-600 focus:ring-2 focus:ring-sky-100" placeholder="Quezon City" />
                </div>
              </div>
              <div class="mt-6">
                <label for="message" class="text-sm font-bold text-sky-950">What can we help with?</label>
                <textarea id="message" name="message" rows="5" required class="mt-2 w-full resize-y rounded-md border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-sky-600 focus:ring-2 focus:ring-sky-100" placeholder="For example: The unit is leaking and has not been cooling well for a few days."></textarea>
                <p class="mt-2 text-sm text-slate-500">Include the issue, the unit type if you know it, and any timing that matters.</p>
              </div>
              <p id="form-error" class="mt-5 hidden rounded-md bg-red-50 px-4 py-3 text-sm font-medium text-red-700" role="alert">Please complete the required fields before sending your request.</p>
              <button type="submit" class="mt-7 inline-flex rounded-md bg-sky-600 px-5 py-3.5 text-base font-bold text-white shadow-sm transition hover:bg-sky-700 focus:outline-2 focus:outline-offset-2 focus:outline-sky-600">Send quote request</button>
              <p class="mt-4 text-sm leading-6 text-slate-500">Portfolio demonstration: this form does not send personal information.</p>
            </form>

            <div id="form-success" class="hidden py-8 text-center" tabindex="-1">
              <span class="mx-auto grid size-14 place-items-center rounded-full bg-teal-100 text-2xl font-black text-teal-700" aria-hidden="true">✓</span>
              <p class="mt-5 text-sm font-black uppercase tracking-[0.16em] text-teal-700">Request prepared</p>
              <h2 class="mt-3 text-3xl font-black tracking-tight text-sky-950">Thanks for reaching out.</h2>
              <p class="mx-auto mt-4 max-w-md leading-7 text-slate-600">This portfolio form works as a front-end demo, so no information was sent. A live client site can connect this step to a free form service.</p>
              <a href="/" class="mt-7 inline-flex rounded-md bg-sky-600 px-5 py-3.5 text-base font-bold text-white transition hover:bg-sky-700 focus:outline-2 focus:outline-offset-2 focus:outline-sky-600">Back to home</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-sky-950 text-sky-100"><div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-10 sm:px-8 md:flex-row md:items-end md:justify-between"><div><p class="text-2xl font-black tracking-tight text-white">Breezy</p><p class="mt-2 text-sm text-sky-200">Aircon cleaning, repair &amp; installation.</p></div><div class="text-sm leading-7 text-sky-200 md:text-right"><p>Serving homes and small businesses.</p><p>© {new Date().getFullYear()} Breezy. Concept portfolio project.</p></div></div></footer>

    <script>
      const form = document.querySelector<HTMLFormElement>("#quote-form");
      const error = document.querySelector<HTMLElement>("#form-error");
      const success = document.querySelector<HTMLElement>("#form-success");

      form?.addEventListener("submit", (event) => {
        event.preventDefault();

        if (!form.checkValidity()) {
          error?.classList.remove("hidden");
          form.reportValidity();
          return;
        }

        error?.classList.add("hidden");
        form.hidden = true;
        success?.classList.remove("hidden");
        success?.focus();
      });
    </script>
  </body>
</html>
