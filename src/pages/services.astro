---
import "../styles/global.css";

const services = [
  {
    number: "01",
    image: "/images/services/cleaning.png",
    icon: "sparkles",
    title: "Aircon cleaning",
    eyebrow: "For fresher, more efficient cooling",
    description: "A detailed clean for indoor units that have gathered dust, moisture, and everyday buildup.",
    includes: ["Cleaning of accessible filters and indoor-unit surfaces", "A visual check for drainage concerns", "Basic function check after service"],
    goodFor: "Units with weaker airflow, musty smells, visible dust, or a long gap since their last clean.",
  },
  {
    number: "02",
    image: "/images/services/diagnostics.png",
    icon: "wrench",
    title: "Repair & diagnostics",
    eyebrow: "For problems that need a clear answer",
    description: "A careful inspection to understand what is affecting the unit before recommending the next step.",
    includes: ["Assessment of cooling, noise, leaks, and power issues", "Plain-language explanation of the likely cause", "Recommended repair options before work proceeds"],
    goodFor: "Aircons that are not cooling properly, are making unusual sounds, or show signs of leaking.",
  },
  {
    number: "03",
    image: "/images/services/installation.png",
    icon: "aircon",
    title: "Installation",
    eyebrow: "For a tidy, dependable start",
    description: "Thoughtful split-type aircon installation planned around your room, access, and unit requirements.",
    includes: ["Basic site assessment before installation", "Careful indoor and outdoor unit positioning", "Startup and operation check once installed"],
    goodFor: "New rooms, replacement units, or homes and small offices ready for reliable cooling.",
  },
  {
    number: "04",
    image: "/images/services/maintenance.png",
    icon: "calendar",
    title: "Preventive maintenance",
    eyebrow: "For fewer surprises later",
    description: "Routine care designed to keep your unit clean, dependable, and ready for frequent use.",
    includes: ["Scheduled cleaning and basic health checks", "Early identification of common wear concerns", "Simple maintenance guidance between visits"],
    goodFor: "Homes and small teams that rely on aircon regularly and prefer planned upkeep.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Explore Breezy's fictional aircon cleaning, repair, installation, and preventive maintenance services." />
    <meta name="theme-color" content="#082f49" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Breezy" />
    <meta property="og:title" content="Services | Breezy" />
    <meta property="og:description" content="Explore Breezy's aircon cleaning, repair, installation, and preventive maintenance services." />
    <meta property="og:image" content="/images/services-hero.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Services | Breezy" />
    <meta name="twitter:description" content="Explore Breezy's aircon cleaning, repair, installation, and preventive maintenance services." />
    <meta name="twitter:image" content="/images/services-hero.png" />
    <title>Services | Breezy</title>
  </head>
  <body class="bg-[#f7fbff] font-sans text-slate-900 antialiased">
    <a class="absolute left-4 top-4 z-50 -translate-y-16 rounded-lg bg-slate-950 px-4 py-3 text-sm font-bold text-white transition focus:translate-y-0" href="#main-content">Skip to content</a>

    <header class="relative z-20 border-b border-sky-100 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
        <a href="/" class="flex items-center gap-2.5 text-2xl font-black tracking-tight text-sky-950" aria-label="Breezy home">
          <span class="grid size-9 place-items-center rounded-xl bg-sky-600 text-white shadow-sm" aria-hidden="true"><svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="2.4"><path d="M4 9h11a3 3 0 1 0-3-3" stroke-linecap="round"/><path d="M4 15h15a3 3 0 1 1-3 3" stroke-linecap="round"/></svg></span>
          Breezy
        </a>
        <nav class="hidden items-center gap-7 text-sm font-semibold text-slate-600 md:flex" aria-label="Primary navigation">
          <a class="text-sky-700" aria-current="page" href="/services/">Services</a>
          <a class="transition hover:text-sky-700" href="/#how-it-works">How it works</a>
          <a class="transition hover:text-sky-700" href="/#faq">FAQs</a>
        </nav>
        <a href="/quote/" class="hidden rounded-md bg-sky-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-sky-700 focus:outline-2 focus:outline-offset-2 focus:outline-sky-600 md:inline-flex">Request a quote</a>
        <details class="relative md:hidden">
          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-sky-200 px-3 py-2 text-sm font-bold text-sky-800 transition hover:bg-sky-50 [&::-webkit-details-marker]:hidden">Menu <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="2.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
          <nav class="absolute right-0 top-full z-30 mt-3 w-56 rounded-xl border border-sky-100 bg-white p-2 shadow-xl" aria-label="Mobile navigation">
            <a class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-sky-50 hover:text-sky-700" href="/services/">Services</a>
            <a class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-sky-50 hover:text-sky-700" href="/#how-it-works">How it works</a>
            <a class="block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-sky-50 hover:text-sky-700" href="/#faq">FAQs</a>
            <a class="mt-1 block rounded-lg bg-sky-600 px-3 py-2.5 text-sm font-bold text-white transition hover:bg-sky-700" href="/quote/">Request a quote</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <section class="relative overflow-hidden bg-sky-950 text-white">
        <div class="absolute -right-28 -top-24 size-96 rounded-full bg-sky-800/60 blur-3xl"></div>
        <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[.85fr_.65fr] lg:py-20">
          <div>
            <p class="text-sm font-black uppercase tracking-[0.18em] text-teal-300">Breezy services</p>
            <h1 class="mt-4 max-w-3xl text-5xl font-black tracking-[-0.045em] sm:text-6xl">Practical care for every kind of cool.</h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-sky-100/80">Choose the help your unit needs today, from a thorough clean to a full installation. Every service starts with a clear conversation.</p>
            <a href="#service-list" class="mt-9 inline-flex rounded-md bg-teal-400 px-5 py-3.5 text-base font-bold text-sky-950 transition hover:bg-teal-300 focus:outline-2 focus:outline-offset-2 focus:outline-teal-300">See all services</a>
          </div>
          <div class="hidden justify-end lg:flex">
            <img src="/images/services-hero.png" alt="A Breezy technician beside a split-type aircon unit" class="w-full max-w-xl object-contain" />
          </div>
        </div>
      </section>

      <section id="service-list" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
        <div class="max-w-2xl"><p class="text-sm font-black uppercase tracking-[0.18em] text-sky-600">What we can help with</p><h2 class="mt-3 text-3xl font-black tracking-tight text-sky-950 sm:text-4xl">The right service starts with the right information.</h2></div>
        <div class="mt-12 space-y-6">
          {services.map((service) => (
            <article class="grid gap-7 rounded-xl border border-sky-100 bg-white p-6 shadow-sm sm:p-9 lg:grid-cols-[.16fr_.84fr] lg:gap-8">
              <div class="flex flex-col gap-6 lg:gap-8">
                <p class="self-start text-sm font-black tracking-[0.18em] text-sky-500">{service.number}</p>
                <img src={service.image} alt="" aria-hidden="true" loading="lazy" class="hidden object-contain object-left lg:mt-12 lg:block lg:h-48 lg:w-full lg:self-start" />
              </div>
              <div>
                <div class="flex items-center gap-4 lg:block">
                  <div class="min-w-0">
                  <p class="text-sm font-bold text-teal-700">{service.eyebrow}</p>
                  <div class="mt-2 flex items-center gap-3">
                    <h3 class="text-2xl font-black tracking-tight text-sky-950 sm:text-3xl">{service.title}</h3>
                    <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-sky-50 text-sky-600" aria-hidden="true">
                    {service.icon === "sparkles" && <svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.5 5.5L5 10l5.5 1.5L12 17l1.5-5.5L19 10l-5.5-1.5L12 3Z"/><path d="m19 16-.7 2.3L16 19l2.3.7L19 22l.7-2.3L22 19l-2.3-.7L19 16Z"/></svg>}
                    {service.icon === "wrench" && <svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m14.7 6.3 3-3a5 5 0 0 1-6.4 6.4l-6.8 6.8a2.1 2.1 0 1 0 3 3l6.8-6.8a5 5 0 0 1 6.4-6.4l-3 3"/></svg>}
                    {service.icon === "aircon" && <svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="9" rx="2"/><path d="M6 10h12M7 18c1 1 2 1 3 0m2 0c1 1 2 1 3 0"/></svg>}
                    {service.icon === "calendar" && <svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4m8-4v4M3 10h18m-11 5 2 2 4-4"/></svg>}
                    </span>
                  </div>
                  <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">{service.description}</p>
                </div>
                  <img src={service.image} alt="" aria-hidden="true" loading="lazy" class="size-28 shrink-0 object-contain lg:hidden" />
                </div>
                <div class="mt-4 grid gap-7 border-t border-sky-100 pt-7 md:grid-cols-2">
                  <div><h4 class="text-sm font-black uppercase tracking-[0.14em] text-sky-800">What’s included</h4><ul class="mt-4 space-y-3 text-slate-600">{service.includes.map((item) => (<li class="flex gap-3 leading-6"><span class="mt-1 grid size-5 shrink-0 place-items-center rounded-full bg-teal-100 text-xs font-black text-teal-700" aria-hidden="true">✓</span>{item}</li>))}</ul></div>
                  <div class="rounded-2xl bg-sky-50 p-5"><h4 class="text-sm font-black uppercase tracking-[0.14em] text-sky-800">This may be right for you if…</h4><p class="mt-4 leading-7 text-slate-600">{service.goodFor}</p></div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="quote" class="mx-auto max-w-7xl px-5 pb-20 sm:px-8 lg:pb-28"><div class="rounded-3xl bg-teal-500 px-6 py-12 text-sky-950 sm:px-12 lg:flex lg:items-center lg:justify-between lg:gap-12"><div class="max-w-2xl"><p class="text-sm font-black uppercase tracking-[0.18em] text-teal-950/70">Not sure which service fits?</p><h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">Start with a quick description of the problem.</h2><p class="mt-4 text-lg leading-8 text-teal-950/80">We’ll help identify the right place to begin and prepare a clear estimate.</p></div><a href="/quote/" class="mt-7 inline-flex rounded-md bg-sky-950 px-5 py-3.5 text-base font-bold text-white shadow-lg transition hover:bg-sky-900 focus:outline-2 focus:outline-offset-2 focus:outline-sky-950 lg:mt-0">Request a quote</a></div><p class="mt-4 text-center text-sm text-slate-500">Concept portfolio project. Sample contact details only.</p></section>
    </main>

    <footer class="bg-sky-950 text-sky-100"><div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-10 sm:px-8 md:flex-row md:items-end md:justify-between"><div><p class="text-2xl font-black tracking-tight text-white">Breezy</p><p class="mt-2 text-sm text-sky-200">Aircon cleaning, repair &amp; installation.</p></div><div class="text-sm leading-7 text-sky-200 md:text-right"><p>Serving homes and small businesses.</p><p>© {new Date().getFullYear()} Breezy. Concept portfolio project.</p></div></div></footer>
  </body>
</html>
