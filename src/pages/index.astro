---
import "../styles/global.css";

const services = [
  { title: "Aircon cleaning", description: "Deep cleaning that helps your unit blow fresher, cooler air.", icon: "sparkles" },
  { title: "Repair & diagnostics", description: "Clear answers and practical repairs for leaks, noise, and weak cooling.", icon: "tool" },
  { title: "Installation", description: "Neat, careful installation for split-type units in homes and small offices.", icon: "home" },
  { title: "Preventive maintenance", description: "Routine care to keep your aircon dependable through the warmer months.", icon: "calendar" },
];

const steps = [
  ["01", "Tell us what you need", "Choose a service and describe your unit or concern."],
  ["02", "Get a clear estimate", "We confirm the scope before any work begins."],
  ["03", "Enjoy a cooler space", "A trained technician arrives ready to get it sorted."],
];

const faqs = [
  ["How often should my aircon be cleaned?", "Most home units benefit from cleaning every three to six months, depending on how often you use them."],
  ["What should I do if my aircon is not cooling?", "Try cleaning the filter first. If the issue continues, request a diagnostic visit so the unit can be checked safely."],
  ["Do you serve businesses too?", "Yes. Breezy is set up for homes and small offices. Larger projects can be discussed during the quote request."],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Breezy is a fictional aircon cleaning, repair, installation, and maintenance service website." />
    <title>Breezy | Aircon Cleaning, Repair & Installation</title>
  </head>
  <body class="bg-[#f7fbff] font-sans text-slate-900 antialiased">
    <a class="absolute left-4 top-4 z-50 -translate-y-16 rounded-lg bg-slate-950 px-4 py-3 text-sm font-bold text-white transition focus:translate-y-0" href="#main-content">Skip to content</a>

    <header class="border-b border-sky-100 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
        <a href="#top" class="flex items-center gap-2.5 text-2xl font-black tracking-tight text-sky-950" aria-label="Breezy home">
          <span class="grid size-9 place-items-center rounded-xl bg-sky-600 text-white shadow-sm" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="2.4"><path d="M4 9h11a3 3 0 1 0-3-3" stroke-linecap="round"/><path d="M4 15h15a3 3 0 1 1-3 3" stroke-linecap="round"/></svg>
          </span>
          Breezy
        </a>
        <nav class="hidden items-center gap-7 text-sm font-semibold text-slate-600 md:flex" aria-label="Primary navigation">
          <a class="transition hover:text-sky-700" href="#services">Services</a>
          <a class="transition hover:text-sky-700" href="#how-it-works">How it works</a>
          <a class="transition hover:text-sky-700" href="#faq">FAQs</a>
        </nav>
        <a href="#quote" class="rounded-md bg-sky-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-sky-700 focus:outline-2 focus:outline-offset-2 focus:outline-sky-600">Request a quote</a>
      </div>
    </header>

    <main id="main-content">
      <section id="top" class="relative overflow-hidden bg-white">
        <div class="absolute inset-x-0 top-0 h-80 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-sky-100 via-transparent to-transparent"></div>
        <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.05fr_.95fr] lg:py-24">
          <div class="max-w-2xl">
            <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-sky-50 px-3 py-1.5 text-sm font-bold text-sky-800"><span class="size-2 rounded-full bg-teal-500"></span> Cooler, cleaner spaces start here</p>
            <h1 class="max-w-xl text-5xl font-black tracking-[-0.045em] text-sky-950 sm:text-6xl lg:text-7xl">Feel at home in the <span class="text-sky-400">cool</span></h1>
            <p class="mt-6 max-w-lg text-lg leading-8 text-slate-600">Friendly aircon cleaning, repair, installation, and maintenance for homes and small businesses.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#quote" class="rounded-md bg-sky-600 px-5 py-3.5 text-base font-bold text-white shadow-lg shadow-sky-200 transition hover:bg-sky-700 focus:outline-2 focus:outline-offset-2 focus:outline-sky-600">Request a quote</a>
              <a href="#services" class="rounded-md border border-sky-200 bg-white px-5 py-3.5 text-base font-bold text-sky-900 transition hover:border-sky-400 hover:bg-sky-50">Explore services</a>
            </div>
            <div class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm font-semibold text-slate-600">
              <span class="inline-flex items-center gap-2"><span class="grid size-5 place-items-center rounded-full bg-teal-100 text-teal-700">✓</span> Clear, upfront estimates</span>
              <span class="inline-flex items-center gap-2"><span class="grid size-5 place-items-center rounded-full bg-teal-100 text-teal-700">✓</span> Careful, tidy service</span>
            </div>
          </div>
          <div class="relative mx-auto w-full max-w-xl">
            <div class="absolute -inset-4 -rotate-3 rounded-[2rem] bg-sky-100"></div>
            <img src="/images/breezy-technician.png" width="1800" height="1200" alt="A technician cleaning a wall-mounted air conditioner in a bright home" class="relative aspect-[4/3] w-full rounded-[1.7rem] object-cover shadow-2xl shadow-sky-200/70" />
            <div class="absolute -bottom-5 -left-3 rounded-2xl border border-sky-100 bg-white px-4 py-3 shadow-xl sm:-left-7 sm:px-5"><p class="text-xs font-bold uppercase tracking-widest text-sky-600">Breezy promise</p><p class="mt-1 text-sm font-bold text-slate-800">Service that feels like a breeze!</p></div>
          </div>
        </div>
      </section>

      <section id="services" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
        <div class="max-w-2xl"><p class="text-sm font-black uppercase tracking-[0.18em] text-sky-600">Our services</p><h2 class="mt-3 text-3xl font-black tracking-tight text-sky-950 sm:text-4xl">Everything your aircon needs to keep going.</h2><p class="mt-4 text-lg leading-8 text-slate-600">From a quick clean to a full installation, Breezy makes routine aircon care easier to understand.</p></div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {services.map((service) => (
            <article class="group rounded-2xl border border-sky-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-sky-200 hover:shadow-lg hover:shadow-sky-100/60">
              <div class="grid size-11 place-items-center rounded-xl bg-sky-50 text-sky-700" aria-hidden="true">
                {service.icon === "sparkles" && <svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="2"><path d="m12 3 1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3Z" stroke-linejoin="round"/><path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z" stroke-linejoin="round"/></svg>}
                {service.icon === "tool" && <svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="2"><path d="m14.7 6.3 3 3M3 21l7.5-7.5M13 6l-3.5 3.5a4 4 0 0 1 5 5L18 11a4 4 0 0 0-5-5Z" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                {service.icon === "home" && <svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="2"><path d="m3 11 9-8 9 8v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-9Z" stroke-linejoin="round"/><path d="M9 21v-6h6v6"/></svg>}
                {service.icon === "calendar" && <svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18" stroke-linecap="round"/></svg>}
              </div>
              <h3 class="mt-5 text-lg font-black text-sky-950">{service.title}</h3><p class="mt-2 text-base leading-7 text-slate-600">{service.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="how-it-works" class="bg-sky-950 text-white"><div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-24"><div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20"><div><p class="text-sm font-black uppercase tracking-[0.18em] text-sky-300">How it works</p><h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">A straightforward path back to cool.</h2><p class="mt-5 max-w-md text-lg leading-8 text-sky-100/80">No confusing steps. Just the information you need, a clear plan, and service that respects your space.</p></div><ol class="grid gap-5 sm:grid-cols-3">{steps.map(([number, title, description]) => (<li class="border-t border-sky-700 pt-5"><span class="text-sm font-black tracking-widest text-teal-300">{number}</span><h3 class="mt-4 text-lg font-black">{title}</h3><p class="mt-2 leading-7 text-sky-100/75">{description}</p></li>))}</ol></div></div></section>

      <section id="quote" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28"><div class="overflow-hidden rounded-3xl bg-teal-500 px-6 py-12 text-sky-950 sm:px-12 lg:flex lg:items-center lg:justify-between lg:gap-12"><div class="max-w-2xl"><p class="text-sm font-black uppercase tracking-[0.18em] text-teal-950/70">Get started</p><h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">Ready for a fresher, cooler space?</h2><p class="mt-4 text-lg leading-8 text-teal-950/80">Tell us what your unit needs and we’ll prepare a clear service estimate.</p></div><a href="mailto:hello@breezy.example?subject=Quote%20request" class="mt-7 inline-flex rounded-md bg-sky-950 px-5 py-3.5 text-base font-bold text-white shadow-lg transition hover:bg-sky-900 focus:outline-2 focus:outline-offset-2 focus:outline-sky-950 lg:mt-0">Request a quote</a></div><p class="mt-4 text-center text-sm text-slate-500">Concept portfolio project. Sample contact details only.</p></section>

      <section id="faq" class="border-t border-sky-100 bg-white"><div class="mx-auto max-w-3xl px-5 py-20 sm:px-8"><p class="text-sm font-black uppercase tracking-[0.18em] text-sky-600">Frequently asked questions</p><h2 class="mt-3 text-3xl font-black tracking-tight text-sky-950 sm:text-4xl">A few helpful answers.</h2><div class="mt-8 divide-y divide-sky-100 border-y border-sky-100">{faqs.map(([question, answer]) => (<details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-bold text-sky-950 marker:hidden">{question}<span class="text-2xl font-normal text-sky-500 transition group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-2xl pt-3 leading-7 text-slate-600">{answer}</p></details>))}</div></div></section>
    </main>

    <footer class="bg-sky-950 text-sky-100"><div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-10 sm:px-8 md:flex-row md:items-end md:justify-between"><div><p class="text-2xl font-black tracking-tight text-white">Breezy</p><p class="mt-2 text-sm text-sky-200">Aircon cleaning, repair &amp; installation.</p></div><div class="text-sm leading-7 text-sky-200 md:text-right"><p>Serving homes and small businesses.</p><p>© {new Date().getFullYear()} Breezy. Concept portfolio project.</p></div></div></footer>
  </body>
</html>
